rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /guardians/{guardianId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /incidents/{incidentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /live_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.victimUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.victimUid == request.auth.uid;
    }

    match /active_alerts/{alertId} {
      allow read: if signedIn() && (
        resource.data.victimUid == request.auth.uid ||
        request.auth.token.email in resource.data.guardianEmails
      );
      allow create: if signedIn() && request.resource.data.victimUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.victimUid == request.auth.uid;
    }
  }
}
